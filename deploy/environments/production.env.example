# Copy to production.env and fill in real values:
#   cp deploy/environments/production.env.example deploy/environments/production.env
#
# production.env is gitignored — do not commit it.

GCP_PROJECT_ID=
GCP_REGION=us-central1
CLOUD_RUN_SERVICE=easyreview-api
ARTIFACT_REPO=easyreview

APP_ENV=production

# gcloud sql instances list --project=YOUR_PROJECT_ID --format='value(connectionName)'
CLOUD_SQL_INSTANCE=

DATABASE_SECRET=DATABASE_URL
JWT_SECRET_NAME=JWT_SECRET
GEMINI_API_KEY_SECRET=GEMINI_API_KEY
GOOGLE_MAPS_API_KEY_SECRET=GOOGLE_MAPS_API_KEY
BREVO_API_KEY_SECRET=BREVO_API_KEY
CRON_SECRET_NAME=CRON_SECRET

JWT_ACCESS_TOKEN_EXPIRATION=24h
JWT_REFRESH_TOKEN_EXPIRATION=30d

CLOUD_RUN_MEMORY=512Mi
CLOUD_RUN_CPU=1
CLOUD_RUN_MIN_INSTANCES=1
CLOUD_RUN_MAX_INSTANCES=5
CLOUD_RUN_TIMEOUT=900
CLOUD_RUN_ALLOW_UNAUTHENTICATED=true
