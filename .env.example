PORT=3000
NODE_ENV=staging

# Local / public IP:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/easyreview?sslmode=require
#
# Cloud Run + Cloud SQL (Unix socket) — store this in Secret Manager as DATABASE_URL:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost/easyreview?host=/cloudsql/PROJECT:REGION:INSTANCE

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/easyreview?sslmode=require

JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRATION=14d
JWT_REFRESH_TOKEN_EXPIRATION=30d

# Google AI Studio → https://aistudio.google.com/apikey (free tier available)
GEMINI_API_KEY=

# Google Maps / Places API (New) server key — Places API enabled, no HTTP referrer restriction
GOOGLE_MAPS_API_KEY=

# Google OAuth Web client ID (Sign in with Google) — APIs & Services → Credentials
GOOGLE_OAUTH_CLIENT_ID=

# Brevo (Sendinblue) transactional email → https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

# Shared secret for Cloud Scheduler → POST /internal/jobs/* (header: x-cron-secret)
CRON_SECRET=

# Public GCS bucket for EasyMenu item photos (yarn gcp:menu-bucket:staging|production)
GCS_MENU_BUCKET=
